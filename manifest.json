{
  "manifest_version": 3,
  "name": "mltx",
  "version": "0.3.1",
  "description": "Turns the x.com home timeline into a window-filling masonry, with side panels and a post window over it.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://x.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow-panel-frame",
        "enabled": true,
        "path": "frame-rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "masonry.js"
      ],
      "css": [
        "masonry.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "panel-frame.js"
      ],
      "css": [
        "panel-frame.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
