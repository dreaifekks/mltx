{
  "manifest_version": 3,
  "name": "mltx",
  "version": "0.4.1",
  "description": "__MSG_description__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "mltx",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": [
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "allow-panel-frame",
        "enabled": true,
        "path": "frame-rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "settings-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "i18n.js",
        "common.js",
        "masonry.js"
      ],
      "css": [
        "masonry.css"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "js": [
        "common.js",
        "panel-frame.js"
      ],
      "css": [
        "panel-frame.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
